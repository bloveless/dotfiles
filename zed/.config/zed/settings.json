// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cursor_shape": "bar",
  "cursor_animation": {
    "enabled": true
  },
  "profiles": {
    "home": {
      "settings": {
        "ssh_connections": [
          {
            "host": "devbox",
            "args": [],
            "projects": [
              {
                "paths": [
                  "/home/brennon/Projects/gitea.lan.brennonloveless.com/brennon/micro"
                ]
              }
            ]
          },
          {
            "host": "herdr",
            "args": [],
            "projects": []
          }
        ],
        "agent": {
          "default_model": {
            "provider": "opencode",
            "model": "go/deepseek-v4-flash",
            "enable_thinking": true,
            "effort": "max"
          },
          "terminal_init_command": "pi",
        },
        "agent_servers": {
          "opencode": {
            "default_config_options": {
              "effort": "high",
              "mode": "build",
              "model": "opencode/space-bunny-free"
            },
            "type": "registry"
          },
          "codex-acp": {
            "type": "registry",
          },
        },
        "edit_predictions": {
          "provider": "zed",
        },
      },
    },
    "work": {
      "settings": {
        "agent": {
          "terminal_init_command": "cursor-agent",
        },
        "edit_predictions": {
          "provider": "copilot",
        },
        "agent_servers": {
          "pi-acp": {
            "default_config_options": {
              "thought_level": "high",
              "model": "cursor/auto"
            },
            "type": "registry"
          },
          "cursor": {
            "default_config_options": {
              "reasoning": "high",
              "optimize_for": "balanced",
              "model": "auto-smart",
            },
            "type": "registry",
          },
        },
      },
    },
  },
  "colorize_brackets": true,
  "tabs": {
    "show_diagnostics": "all",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato",
  },
  "completion_menu_item_kind": "symbol",
  "buffer_line_height": {
    "custom": 1.75,
  },
  "excerpt_context_lines": 5,
  "expand_excerpt_lines": 10,
  "cli_default_open_behavior": "new_window",
  "vim_mode": true,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "terminal_init_command": "pi",
    "threads_sidebar": {
      "position": "right"
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/hy3",
      "enable_thinking": true,
      "effort": "high"
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "search_web": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
      },
    },
    "thinking_display": "always_expanded",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ui_font_size": 13.0,
  "buffer_font_features": {
    "calt": false,
  },
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "wrap_guides": [
    120
  ],
  "file_types": {
    "SQL": [
      "**/*.ddl",
      "**/*.dml"
    ],
    "Helm": [
      "**/templates/*.yaml"
    ],
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "languages": {
    "PHP": {
      "format_on_save": "on",
      "language_servers": [
        "phpantom_lsp",
        "!intelephense",
        "!phpactor",
        "!phptools",
        "...",
      ],
      "formatter": {
        "external": {
          "command": "mago",
          "arguments": [
            "format",
            "--stdin-input"
          ],
        },
      },
    },
    "Python": {
      "format_on_save": "on",
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        "ty",
        "!basedpyright",
        "!pyright",
        "...",
      ],
    },
    "Proto": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": "language_server",
      "language_servers": [
        "buf"
      ],
    },
    "Terraform": {
      "format_on_save": "on",
    }
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path=stdout",
          "--show-stats=false",
          "--issues-exit-code=1",
        ],
      },
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true
      }
    },
    "intelephense": {
      "initialization_options": {
        "licenceKey": "~/.config/intelephense/licence.txt",
      },
    },
  },
}
